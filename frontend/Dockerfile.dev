# Development Dockerfile for React Frontend
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies.
# NODE_EXTRA_CA_CERTS points npm at the corporate CA cert (e.g. GlobalProtect SASE).
# The cert is mounted as a build secret so it is never baked into an image layer.
RUN --mount=type=secret,id=ca_cert \
    NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/run/secrets/ca_cert} npm install

# Copy source code
COPY . .

# Expose development port
EXPOSE 3000

# Start development server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
